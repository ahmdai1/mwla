# 🚀 MWLAI Environment Configuration
# Copy this file to .env and fill in your values from the services below

# === Database - Supabase PostgreSQL (Free - 500MB) ===
# Get from: https://supabase.com
# Format: postgresql://user:password@host:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/postgres

# === Payload CMS Configuration ===
PAYLOAD_SECRET=your-long-random-secret-min-32-chars
ADMIN_EMAIL=admin@mwlai.com
ADMIN_PASSWORD=Admin1@3

# === AI APIs - Both Free ===
# Google AI Gemini (60 req/min): https://makersuite.google.com/app/apikeys
GOOGLE_API_KEY=your-google-api-key

# Groq AI (Unlimited): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# === Payments - PayPal (Free Integration) ===
# Get from: https://developer.paypal.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_MODE=sandbox

# === Node Configuration ===
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SECURE=false

# === URLs ===
NEXT_PUBLIC_APP_URL=http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api
VITE_APP_URL=http://localhost:5173

# === Cron Jobs (For automated tasks) ===
CRON_SECRET=another-random-secret-string
